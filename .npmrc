# react-scripts 3.x builds on webpack 4, whose module hashing calls into an
# OpenSSL digest that Node 17+ removed from the default provider. Without this
# flag every `npm start` / `npm run build` dies with:
#   Error: error:0308010C:digital envelope routines::unsupported
#
# npm applies `node-options` to the scripts it runs, so this fixes the whole
# team on every platform with no cross-env dependency and no per-shell setup.
# The real fix is upgrading react-scripts; this keeps the app runnable until
# then. Requires Node >= 17 (see "engines"), where the flag exists.
node-options=--openssl-legacy-provider
